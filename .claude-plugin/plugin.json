{
  "name": "delivery-review",
  "version": "1.3.0",
  "description": "基于 git-notes 的双 Agent 交付协作工作流（loop 模式）：上下文确认 → 方案（双轨+用户选择，大改动含产品视角审查）→ 修复 Agent ↔ 审查 Agent 隔离子代理循环迭代 → 人工验收（裁决权归用户）→ 交付报告。强调「未知清单」元认知。",
  "author": {
    "name": "xiaoxiao-svg"
  },
  "homepage": "https://github.com/xiaoxiao-svg/delivery-review-plugin",
  "repository": "https://github.com/xiaoxiao-svg/delivery-review-plugin",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PLUGIN_ROOT/hooks/update-review-material.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
